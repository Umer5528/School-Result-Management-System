# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/srms

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Initial Super Admin (used only by the seed script)
SUPER_ADMIN_NAME=System Owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=ChangeMe_StrongPassword123!
